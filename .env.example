# App
SECRET_KEY=change-me-in-production
ENV=development
TIMEZONE=Europe/Moscow

# Admin bootstrap (создаётся при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Database
POSTGRES_USER=watcher
POSTGRES_PASSWORD=watcher
POSTGRES_DB=watcher
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# CORS for local Vite
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
# Если api.telegram.org недоступен из Docker — укажите proxy, например socks5://user:pass@host:port
TELEGRAM_PROXY_URL=

# Shift rules
DEFAULT_GEO_RADIUS_M=500
REMINDER_MINUTES_BEFORE=15
MORNING_CHECK_HOUR=10
MORNING_CHECK_MINUTE=0
